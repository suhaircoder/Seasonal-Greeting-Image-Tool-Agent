# Optional. The app runs with built-in seasonal templates if these are empty.
# Copy this file to .env and fill in only the services you want to use.

# OpenAI images API (DALL-E)
OPENAI_API_KEY=

# Email via SMTP. Gmail example: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# X (Twitter) user-context keys for posting the image
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
